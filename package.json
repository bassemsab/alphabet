{
  "name": "alphabet",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"bun --bun vite dev --host 0.0.0.0 --port 2000\" \"caddy run --config Caddyfile.dev\"",
    "dev:vite": "vite dev --host 0.0.0.0 --port 2000",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0-next.6",
    "@tailwindcss/vite": "^4.3.0",
    "@types/bun": "latest",
    "@types/three": "^0.187.0",
    "concurrently": "^10.0.6",
    "svelte": "^5.0.0",
    "svelte-adapter-bun": "^0.5.2",
    "svelte-check": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "msedge-tts": "^2.0.8",
    "three": "^0.187.0"
  }
}
